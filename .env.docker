# ==============================================================================
# Konfigurasi Lingkungan Runtime Docker (Personal Document Assistant)
# ==============================================================================

# Koneksi Layanan Ollama di jaringan Docker internal
OLLAMA_HOST=http://ollama:11434
OLLAMA_TIMEOUT_S=300
KEEP_ALIVE=30m

# Model LLM & Parameter Generasi
LLM_MODEL=qwen3:4b-instruct
LLM_THINK=false
NUM_CTX=4096
NUM_PREDICT=384
TEMPERATURE=0.1

# Model Embedding
EMBED_MODEL=bge-m3
EMBED_QUERY_PREFIX=
EMBED_DOC_PREFIX=
EMBED_BATCH=16

# Parameter Ekstraksi Dokumen
PDF_BACKEND=pymupdf
OCR_MIN_CHARS=50
MAX_FILE_MB=50
XLSX_ROW_CHUNK=30

# Parameter Indeks & Penyimpanan
CHUNK_SIZE=800
CHUNK_OVERLAP=100
VECTOR_DTYPE=float32
STEMMER=none

# Parameter Retrieval & RAG
TOP_K=4
CANDIDATES=20
RRF_K=60
MIN_DENSE_SCORE=0.35
MIN_BM25_SCORE=0.0
MAX_CONTEXT_CHARS=4000
HISTORY_TURNS=3
HISTORY_MAX_CHARS=1500
QUERY_REWRITE=false

# Jalur Penyimpanan di dalam Kontainer
DOCS_DIR=/app/data/docs
SAMPLE_DIR=/app/data/sample
INDEX_DIR=/app/data/index

# Konfigurasi Backend FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=
WARMUP=true
MAX_CONCURRENT_CHAT=1
MAX_UPLOAD_MB=50
UPLOAD_SUBDIR=uploads

# Keamanan Jaringan & Logging
# ALLOW_REMOTE=true wajib agar backend dapat berkomunikasi dengan kontainer 'ollama'
ALLOW_REMOTE=true
LOG_CONTENT=false
LOG_LEVEL=INFO

# Konfigurasi Frontend Streamlit
PDA_API_URL=http://backend:8000/api/v1
PDA_API_KEY=
PDA_TIMEOUT=300.0
PDA_POLL_INTERVAL=2.0
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
