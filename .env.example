# ==============================================================================
# Konfigurasi Personal Document Assistant (.env.example)
# Salin file ini menjadi .env untuk menyesuaikan pengaturan lokal.
# ==============================================================================

# Alamat server Ollama (default loopback)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT_S=300
KEEP_ALIVE=30m

# Jumlah thread CPU (None = otomatis sesuai core sistem)
# NUM_THREAD=4

# Model LLM & parameter generasi
LLM_MODEL=qwen3:4b-instruct
LLM_THINK=false
NUM_CTX=4096
NUM_PREDICT=384
TEMPERATURE=0.1

# Model Embedding & parameter batch
EMBED_MODEL=bge-m3
EMBED_QUERY_PREFIX=
EMBED_DOC_PREFIX=
EMBED_BATCH=16

# Parameter Loader Dokumen
PDF_BACKEND=pymupdf
OCR_MIN_CHARS=50
MAX_FILE_MB=50
XLSX_ROW_CHUNK=30

# Parameter Indexing & Storage
CHUNK_SIZE=800
CHUNK_OVERLAP=100
VECTOR_DTYPE=float32
STEMMER=none

# Direktori penyimpanan data dan indeks
DOCS_DIR=data/docs
SAMPLE_DIR=data/sample
INDEX_DIR=data/index

# Keamanan & Logging
# ALLOW_REMOTE=false: Tolak koneksi Ollama di luar 127.0.0.1/localhost/::1
ALLOW_REMOTE=false

# LOG_CONTENT=false: Jangan pernah mencatat teks dokumen atau pertanyaan ke file log
LOG_CONTENT=false
LOG_LEVEL=INFO
